# ============================================================
# X / Twitter Scraper & Dialogflow NLU Configuration
# ============================================================

# --- Browser & Polite Scraping Settings ---
HEADLESS=true
MIN_SCROLL_DELAY=2.0
MAX_SCROLL_DELAY=4.5
PAGE_TIMEOUT_MS=60000
MAX_RETRIES=3
MAX_CONSECUTIVE_EMPTY_SCROLLS=5
OUTPUT_DIR=output

# --- Session & Authentication ---
# Option 1: Provide storage state path (generated by running `python main.py --login`)
AUTH_STATE_FILE=config/auth_state.json

# Option 2: Provide direct session cookies (extracted from browser DevTools: Application -> Cookies -> https://x.com)
TWITTER_AUTH_TOKEN=50365947bff286159829a4cfead6d15523a8d7e4
TWITTER_CT0=ea1a1a9ecdc67835944cb642f5b3951a9b3bddbf6397e963f15cf35acfa38d82552cb0bc68c4371f00e15a37140c29bc2e5c160a277c632db04b5b0112b8fe3fd4a5c39d9b0bedc21534c999c021f32a

# --- Dialogflow NLU Settings (Optional - fallback parser is used if not provided) ---
# Dialogflow Edition: 'cx' or 'es' or 'local'
DIALOGFLOW_EDITION=local
DIALOGFLOW_PROJECT_ID=
DIALOGFLOW_LOCATION=global
DIALOGFLOW_AGENT_ID=
DIALOGFLOW_LANGUAGE_CODE=en
GOOGLE_APPLICATION_CREDENTIALS=
